# Cloud provider API keys (at least one required for live orchestration)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional local models — do not block cloud usage when unset
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Fusion settings
# Runs are stored in the user data directory by default (`fusion config paths`); uncomment to override.
# FUSION_DB_PATH=
FUSION_LOG_RAW_PROMPTS=false
# Set to "mock" only for offline development/tests
# FUSION_DEFAULT_PROVIDER=mock
